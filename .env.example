# Copy to .env (or set these in your host's secrets settings). Never commit real keys.

# Claude API key. Leave empty to run in demo mode with scripted answers.
ANTHROPIC_API_KEY=

# Optional: push notifications through Pushover (https://pushover.net)
# when a question goes unanswered or a visitor leaves contact details.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional overrides
# CHATBOT_MODEL=claude-opus-5-5
# CHATBOT_EFFORT=low
# DATA_DIR=data
# RATE_LIMIT_PER_MINUTE=12
